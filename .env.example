# ---- Required ----
# PostgreSQL connection string (Neon pooled URL recommended on Vercel, e.g. ...-pooler...neon.tech/...?sslmode=require)
DATABASE_URL=
# Public site origin used for Skinner links, QR codes and embeds (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# ---- Storage (required for seller uploads on Vercel) ----
# Vercel Blob read/write token (Vercel → Storage → Blob → connect to project sets this automatically)
BLOB_READ_WRITE_TOKEN=

# ---- Seeding (only used by `npm run db:seed`) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEMO=true
DEMO_SELLER_EMAIL=demo@skinify.app
DEMO_SELLER_PASSWORD=

# ---- Billing (optional; without these, plans can only be assigned by an admin) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Optional: self-host AR runtime/model files ----
# NEXT_PUBLIC_MEDIAPIPE_WASM_BASE=/mediapipe/wasm
# NEXT_PUBLIC_MP_HAND_MODEL=
# NEXT_PUBLIC_MP_FACE_MODEL=
# NEXT_PUBLIC_MP_POSE_MODEL=
# NEXT_PUBLIC_DRACO_DECODER_PATH=
